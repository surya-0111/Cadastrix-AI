# Supabase Configuration for CadastraAI

# Replace with your Supabase Project URL and Anon API Key from Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Google OAuth Redirect URL (defaults to window.location.origin)
# VITE_AUTH_REDIRECT_URL=http://localhost:8443
